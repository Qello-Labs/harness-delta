+#[tokio::test]
+async fn receiver_loss_preserves_unqualified_http_and_blocks_generation() {
+    // Given
+    let (producer, mut receiver) = pair().await;
+    let listener = tokio::net::TcpListener::bind(("127.0.0.1", 0))
+        .await
+        .unwrap();
+    let url = format!("http://{}/auth", listener.local_addr().unwrap());
+    let server = async {
+        let (mut stream, _) = listener.accept().await.unwrap();
+        let mut buffer = [0; 4096];
+        assert!(stream.read(&mut buffer).await.unwrap() > 0);
+        stream
+            .write_all(b"HTTP/1.1 204 No Content\r\nConnection: close\r\n\r\n")
+            .await
+            .unwrap();
+    };
+    let work = async {
+        producer.admit(ROOT, None, true).await.unwrap();
+        let operation = producer.open_operation(ROOT, None, true).await.unwrap();
+        let client = HttpClient::new(reqwest::Client::builder().no_proxy().build().unwrap());
+        // When
+        let response = operation
+            .clone()
+            .scope(client.get(url).send())
+            .await
+            .unwrap();
+        let generation = operation.dispatch().await;
+        (response.status(), generation)
