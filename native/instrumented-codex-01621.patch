+use serde::{Deserialize, Serialize};
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct Bootstrap {
+    pub schema_version: u8,
+    pub protocol: String,
+    pub run_id: Id,
+    pub producer_instance_id: Id,
+    pub task_generation: u64,
+    pub configuration_receipt_id: Id,
+    pub configuration_revision: Id,
+    pub root_session_id: Id,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+#[serde(transparent)]
+pub struct Id(String);
+
+impl Id {
+    pub fn parse(value: &str) -> Result<Self, super::Error> {
+        let bytes = value.as_bytes();
+        if bytes.is_empty()
+            || bytes.len() > 128
+            || !bytes[0].is_ascii_alphanumeric()
+            || !bytes
+                .iter()
+                .all(|v| v.is_ascii_alphanumeric() || b":_-".contains(v))
+        {
+            return Err(super::Error::Protocol);
+        }
+        Ok(Self(value.to_owned()))
+    }
+}
+
+impl<'de> Deserialize<'de> for Id {
+    fn deserialize<D: serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        let value = String::deserialize(deserializer)?;
+        Self::parse(&value).map_err(serde::de::Error::custom)
+    }
+}
+
+#[derive(Debug, Serialize)]
+pub(super) struct Record<'a> {
+    pub schema_version: u8,
+    pub run_id: &'a Id,
+    pub producer_instance_id: &'a Id,
+    pub member_id: &'a Id,
+    pub task_generation: u64,
+    pub sequence: u64,
+    pub previous_record_hash: &'a Option<String>,
+    pub occurred_at: String,
+    pub body: Body,
+}
+
+#[derive(Clone, Debug, Serialize)]
+#[serde(tag = "kind", rename_all = "snake_case")]
+pub(super) enum Body {
+    MemberReady {
+        native_session_id: String,
+        parent_member_id: Option<Id>,
+        child_reservation_id: Option<Id>,
+        configuration_receipt_id: Id,
+    },
+    ChildReserve {
+        parent_member_id: Id,
+    },
+    OperationOpen {
+        operation_id: Id,
+        turn_id: Option<Id>,
+        operation_class: OperationClass,
+        transport_class: TransportClass,
+        requested_model: Model,
+        requested_effort: Effort,
+        configuration_revision: Id,
+    },
+    AttemptReserve {
+        operation_id: Id,
+        retry_parent_attempt_id: Option<Id>,
+    },
+    DispatchCommit {
+        attempt_id: Id,
+    },
+    AttemptTerminal {
+        attempt_id: Id,
+        disposition: Terminal,
+        response_id: Option<Id>,
+        effective_model: Option<Model>,
+        readings: Readings,
+    },
+    OperationClose {
+        operation_id: Id,
+        disposition: CloseDisposition,
+    },
+    UnsupportedOperation {
+        operation_id: Id,
+        operation_class: OperationClass,
+        transport_class: TransportClass,
+        reason: Reason,
+    },
+    CloseRequest,
+    MemberClose {
+        close_fence_id: Id,
+        final_record_sequence: u64,
+        final_record_hash: Option<String>,
+    },
+}
+
+#[derive(Clone, Copy, Debug, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum OperationClass {
+    Generation,
+    Compaction,
+    Warmup,
+    Guardian,
+    Auxiliary,
+    Control,
+    Unknown,
+}
+#[derive(Clone, Copy, Debug, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum TransportClass {
+    HttpResponses,
+    HttpOther,
+    Websocket,
+    Unknown,
+}
+#[derive(Clone, Copy, Debug, Serialize)]
+pub enum Model {
+    #[serde(rename = "gpt-6.1-sol")]
+    Gpt61Sol,
+}
+#[derive(Clone, Copy, Debug, Serialize)]
+pub(super) enum Effort {
+    #[serde(rename = "high")]
+    High,
+}
+#[derive(Clone, Copy, Debug, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum Terminal {
+    ResponseCompleted,
+    ResponseIncomplete,
+    HttpError,
+    TransportError,
+    Cancelled,
+}
+#[derive(Clone, Copy, Debug, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub(super) enum CloseDisposition {
+    Completed,
+    Failed,
+    Cancelled,
+}
+#[derive(Clone, Copy, Debug, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum Reason {
+    UnsupportedProfile,
+    UnsupportedOperation,
+    UnqualifiedTransport,
+    ConfigurationMismatch,
+    TopologyMismatch,
+    IdentityMismatch,
+    RecordGap,
+    RecordConflict,
+    UnresolvedAttempt,
+    MissingUsage,
+    CounterError,
+    AmbiguousResponse,
+    ScopeRevoked,
+    ReceiverLost,
+    ProducerLost,
+    DurabilityUnavailable,
+    MissingMemberClose,
+    MissingValue,
+    PriceCoverage,
+    TaskCoverage,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct Receipt {
+    pub schema_version: u8,
+    pub receipt_id: Id,
+    pub run_id: Id,
+    pub control_sequence: u64,
+    pub recorded_at: String,
+    pub body: Gate,
+}
+#[derive(Debug, Deserialize)]
+#[serde(tag = "kind", rename_all = "snake_case", deny_unknown_fields)]
+pub(super) enum Gate {
+    MemberAdmitted {
+        member_id: Id,
+        session_id: Id,
+    },
+    ChildReserved {
+        child_reservation_id: Id,
+        parent_member_id: Id,
+    },
+    AttemptReserved {
+        attempt_id: Id,
+        operation_id: Id,
+        member_id: Id,
+        retry_parent_attempt_id: Option<Id>,
+    },
+    DispatchCommitted {
+        attempt_id: Id,
+    },
+    RecordCommitted {
+        producer_sequence: u64,
+        producer_record_hash: String,
+    },
+    CloseFence {
+        close_fence_id: Id,
+    },
+    ScopeRevoked {
+        reason: Reason,
+    },
+}
+
+pub use super::readings::{Reading, Readings};
+
+pub struct TerminalMetadata {
+    pub response_id: Option<Id>,
+    pub effective_model: Option<Model>,
+    pub readings: Readings,
+}
+
+impl TerminalMetadata {
+    pub fn missing() -> Self {
+        Self {
+            response_id: None,
+            effective_model: None,
+            readings: Readings::missing(),
+        }
+    }
+}
