+#[tokio::test]
+async fn auxiliary_http_does_not_consume_a_generation_attempt() {
+    // Given
+    let (producer, mut receiver) = pair().await;
+    let listener = tokio::net::TcpListener::bind(("127.0.0.1", 0))
+        .await
+        .unwrap();
+    let address = listener.local_addr().unwrap();
+    let server = async {
+        for _ in 0..2 {
+            let (mut stream, _) = listener.accept().await.unwrap();
+            let mut buffer = [0; 4096];
+            assert!(stream.read(&mut buffer).await.unwrap() > 0);
+            stream
+                .write_all(b"HTTP/1.1 204 No Content\r\nConnection: close\r\n\r\n")
+                .await
+                .unwrap();
+        }
+    };
+    let work = async {
+        producer.admit(ROOT, None, true).await.unwrap();
+        let operation = producer.open_operation(ROOT, None, true).await.unwrap();
+        let inner = reqwest::Client::builder().no_proxy().build().unwrap();
+        let client = HttpClient::new(inner);
+        // When
+        operation
+            .clone()
+            .scope(async {
+                client
+                    .get(format!("http://{address}/auth"))
+                    .send()
+                    .await
+                    .unwrap();
+                client
+                    .post(format!("http://{address}/responses"))
+                    .send()
+                    .await
+                    .unwrap();
+            })
+            .await;
+        operation
+            .terminal(Terminal::ResponseCompleted, TerminalMetadata::missing())
+            .await
+            .unwrap();
+        operation.close(Terminal::ResponseCompleted).await.unwrap();
+    };
+    let receive = async {
+        for _ in 0..7 {
+            receiver.accept().await;
+        }
+        receiver.records
+    };
+    let (_, records, _) = tokio::time::timeout(RECEIPT_TIMEOUT, async {
+        tokio::join!(work, receive, server)
+    })
+    .await
+    .unwrap();
+    // Then
+    assert_eq!(
+        records
+            .iter()
+            .filter(|record| record["body"]["kind"] == "attempt_reserve")
+            .count(),
+        1
+    );
+    assert_eq!(records[2]["body"]["kind"], "unsupported_operation");
+    assert_eq!(records[2]["body"]["transport_class"], "http_other");
+}
