index 0000000000000000000000000000000000000000..d7acadce8f257991cfec970cf1eba9d91067793f
--- /dev/null
+++ b/codex-rs/http-client/src/accounting/mod.rs
@@ -0,0 +1,243 @@
+mod channel;
+#[cfg(unix)]
+mod descriptor;
+mod lifecycle;
+mod operation;
+mod readings;
+mod wire;
+
+use operation::CURRENT;
+pub use operation::Operation;
+pub use wire::{
+    Id, Model, OperationClass, Reading, Readings, Reason, Terminal, TerminalMetadata,
+    TransportClass,
+};
+
+use channel::{Channel, Exchange};
+use std::collections::BTreeMap;
+use std::sync::Arc;
+use std::sync::OnceLock;
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use tokio::sync::{Mutex, RwLock};
+use wire::{Body, Gate};
+
+static PRODUCER: OnceLock<Arc<Producer>> = OnceLock::new();
+tokio::task_local! {
+    static FEATURED_PLUGIN_LOOKUP: ();
+    static CURATED_PLUGIN_LOOKUP: Option<reqwest::Url>;
+}
+
+pub async fn featured_plugin_lookup_scope<T>(future: impl std::future::Future<Output = T>) -> T {
+    FEATURED_PLUGIN_LOOKUP.scope((), future).await
+}
+
+pub fn is_featured_plugin_lookup_scope() -> bool {
+    FEATURED_PLUGIN_LOOKUP.try_with(|()| ()).is_ok()
+}
+
+pub async fn curated_plugin_lookup_scope<T>(
+    url: &str,
+    future: impl std::future::Future<Output = T>,
+) -> T {
+    CURATED_PLUGIN_LOOKUP
+        .scope(reqwest::Url::parse(url).ok(), future)
+        .await
+}
+
+pub fn is_curated_plugin_lookup_request(url: &reqwest::Url) -> bool {
+    CURATED_PLUGIN_LOOKUP
+        .try_with(|expected| expected.as_ref() == Some(url))
+        .unwrap_or(false)
+}
+
+const RECEIPT_TIMEOUT: std::time::Duration = std::time::Duration::from_secs(15);
+
+#[derive(Debug, thiserror::Error)]
+pub enum Error {
+    #[error("accounting receiver unavailable")]
+    Lost,
+    #[error("accounting protocol violation")]
+    Protocol,
+    #[error("accounting scope revoked")]
+    Revoked,
+    #[error("accounting family fenced")]
+    Fenced,
+    #[error("accounting descriptor I/O failed")]
+    Io(#[from] std::io::Error),
+}
+
+pub(super) struct NativeMember {
+    id: Id,
+    stopped: bool,
+    qualified: bool,
+}
+pub(super) struct Family {
+    members: BTreeMap<String, NativeMember>,
+    root: Option<Id>,
+    children: u8,
+}
+pub struct Producer {
+    channel: Arc<Mutex<Channel>>,
+    family: Arc<Mutex<Family>>,
+    broken: AtomicBool,
+    closing: AtomicBool,
+    ids: AtomicU64,
+    writers: Arc<RwLock<()>>,
+}
+
+impl Producer {
+    pub async fn connect(stream: tokio::net::UnixStream) -> Result<Arc<Self>, Error> {
+        let channel = tokio::time::timeout(RECEIPT_TIMEOUT, Channel::connect(stream))
+            .await
+            .map_err(|_| Error::Lost)??;
+        Ok(Arc::new(Self {
+            channel: Arc::new(Mutex::new(channel)),
+            family: Arc::new(Mutex::new(Family {
+                members: BTreeMap::new(),
+                root: None,
+                children: 0,
+            })),
+            broken: AtomicBool::new(false),
+            closing: AtomicBool::new(false),
+            ids: AtomicU64::new(1),
+            writers: Arc::new(RwLock::new(())),
+        }))
+    }
+
+    fn id(&self, prefix: &str) -> Result<Id, Error> {
+        let id = self
+            .ids
+            .fetch_update(Ordering::SeqCst, Ordering::SeqCst, |v| v.checked_add(1))
+            .map_err(|_| Error::Protocol)?;
+        Id::parse(&format!("{prefix}:{id}"))
+    }
+
+    async fn emit(&self, member: &Id, body: Body) -> Result<Gate, Error> {
+        let mut channel = self.channel.clone().lock_owned().await;
+        if self.broken.load(Ordering::SeqCst) {
+            return Err(Error::Lost);
+        }
+        let exchange = Exchange::new(&self.broken);
+        let result = tokio::time::timeout(RECEIPT_TIMEOUT, channel.send(member, body))
+            .await
+            .map_err(|_| Error::Lost)??;
+        exchange.commit();
+        Ok(result)
+    }
+
+    async fn root(&self) -> Result<Id, Error> {
+        self.family.lock().await.root.clone().ok_or(Error::Protocol)
+    }
+}
+
+pub fn enabled() -> bool {
+    PRODUCER.get().is_some()
+}
+pub fn producer() -> Option<Arc<Producer>> {
+    PRODUCER.get().cloned()
+}
+
+#[cfg(unix)]
+pub async fn initialize_fd3() -> Result<(), Error> {
+    let stream = descriptor::take_fd3()?;
+    let producer = Producer::connect(stream).await?;
+    PRODUCER.set(producer).map_err(|_| Error::Protocol)
+}
+
+#[cfg(not(unix))]
+pub async fn initialize_fd3() -> Result<(), Error> {
+    Err(Error::Protocol)
+}
+
+pub async fn admit_native_member(
+    native: &str,
+    parent: Option<&str>,
+    ordinary: bool,
+) -> Result<(), Error> {
+    if let Some(producer) = producer() {
+        producer.admit(native, parent, ordinary).await?;
+    }
+    Ok(())
+}
+
+pub async fn native_member_stopped(native: &str) {
+    if let Some(producer) = producer()
+        && let Some(member) = producer.family.lock().await.members.get_mut(native)
+    {
+        member.stopped = true;
+    }
+}
+
+pub async fn close_family() -> Result<(), Error> {
+    if let Some(producer) = producer() {
+        producer.close_family().await?;
+    }
+    Ok(())
+}
+
+#[cfg(all(test, unix))]
+mod test_receiver;
+#[cfg(all(test, unix))]
+mod tests;
+#[cfg(all(test, unix))]
+mod transport_tests;
+
+pub fn current_operation() -> Option<Arc<Operation>> {
+    CURRENT.try_with(Arc::clone).ok()
+}
+
+pub async fn before_dispatch() -> Result<Option<Arc<Operation>>, Error> {
+    let operation = current_operation();
+    if let Some(operation) = operation.as_ref() {
+        operation.dispatch().await?;
+    } else if producer().is_some()
+        && unsupported(
+            OperationClass::Unknown,
+            TransportClass::HttpOther,
+            Reason::UnsupportedOperation,
+        )
+        .await
+        .is_err()
+    {
+        tracing::warn!("accounting receiver unavailable before unqualified HTTP dispatch");
+    }
+    Ok(operation)
+}
+
+pub async fn unsupported(
+    class: OperationClass,
+    transport: TransportClass,
+    reason: Reason,
+) -> Result<(), Error> {
+    if let Some(producer) = current_operation()
+        .map(|operation| operation.producer())
+        .or_else(producer)
+    {
+        let root = {
+            let family = producer.family.lock().await;
+            family.root.clone()
+        };
+        let root = match root {
+            Some(root) => root,
+            None => producer
+                .channel
+                .lock()
+                .await
+                .bootstrap
+                .producer_instance_id
+                .clone(),
+        };
+        producer
+            .emit(
+                &root,
+                Body::UnsupportedOperation {
+                    operation_id: producer.id("unsupported")?,
+                    operation_class: class,
+                    transport_class: transport,
+                    reason,
+                },
+            )
+            .await?;
+    }
+    Ok(())
+}
diff --git a/codex-rs/http-client/src/accounting/operation.rs b/codex-rs/http-client/src/accounting/operation.rs
new file mode 100644
index 0000000000000000000000000000000000000000..8b40125e8f4f0ba286103aea958bf27ca053bf53
--- /dev/null
+++ b/codex-rs/http-client/src/accounting/operation.rs
@@ -0,0 +1,216 @@
+use super::wire::*;
+use super::{Error, Producer, producer, unsupported};
+use std::sync::Arc;
+use std::sync::atomic::Ordering;
+use tokio::sync::{Mutex, OwnedRwLockReadGuard};
+
+tokio::task_local! { pub(super) static CURRENT: Arc<Operation>; }
+
+pub struct Operation {
+    producer: Arc<Producer>,
+    member: Id,
+    id: Id,
+    attempts: Arc<Mutex<Attempts>>,
+    _writer: OwnedRwLockReadGuard<()>,
+}
+struct Attempts {
+    previous: Option<Id>,
+    active: Option<Id>,
+    closed: bool,
+}
+
+impl Operation {
+    pub(super) fn producer(&self) -> Arc<Producer> {
+        self.producer.clone()
+    }
+    pub async fn open(
+        native: &str,
+        turn: Option<&str>,
+        qualified: bool,
+    ) -> Result<Option<Arc<Self>>, Error> {
+        let Some(producer) = producer() else {
+            return Ok(None);
+        };
+        let admitted = producer
+            .family
+            .lock()
+            .await
+            .members
+            .get(native)
+            .is_some_and(|member| member.qualified);
+        if !qualified || !admitted {
+            if unsupported(
+                OperationClass::Unknown,
+                TransportClass::HttpResponses,
+                Reason::ConfigurationMismatch,
+            )
+            .await
+            .is_err()
+            {
+                tracing::warn!("accounting receiver unavailable before unqualified generation");
+            }
+            return Ok(None);
+        }
+        producer
+            .open_operation(native, turn, qualified)
+            .await
+            .map(Some)
+    }
+
+    pub async fn scope<F: std::future::Future>(self: Arc<Self>, future: F) -> F::Output {
+        CURRENT.scope(self, future).await
+    }
+
+    pub async fn dispatch(&self) -> Result<(), Error> {
+        let mut attempts = self.attempts.clone().lock_owned().await;
+        if self.producer.closing.load(Ordering::SeqCst) || attempts.closed {
+            return Err(Error::Fenced);
+        }
+        let previous = attempts.previous.clone();
+        let attempt = match self
+            .producer
+            .emit(
+                &self.member,
+                Body::AttemptReserve {
+                    operation_id: self.id.clone(),
+                    retry_parent_attempt_id: previous.clone(),
+                },
+            )
+            .await?
+        {
+            Gate::AttemptReserved {
+                attempt_id,
+                operation_id,
+                member_id,
+                retry_parent_attempt_id,
+            } if operation_id == self.id
+                && member_id == self.member
+                && retry_parent_attempt_id == previous =>
+            {
+                attempt_id
+            }
+            _ => return Err(Error::Protocol),
+        };
+        attempts.previous = Some(attempt.clone());
+        attempts.active = Some(attempt.clone());
+        match self
+            .producer
+            .emit(
+                &self.member,
+                Body::DispatchCommit {
+                    attempt_id: attempt.clone(),
+                },
+            )
+            .await?
+        {
+            Gate::DispatchCommitted { attempt_id } if attempt_id == attempt => Ok(()),
+            _ => Err(Error::Protocol),
+        }
+    }
+
+    pub async fn terminal(
+        &self,
+        disposition: Terminal,
+        metadata: TerminalMetadata,
+    ) -> Result<(), Error> {
+        let mut attempts = self.attempts.clone().lock_owned().await;
+        let attempt = attempts.active.as_ref().ok_or(Error::Protocol)?.clone();
+        self.producer
+            .emit(
+                &self.member,
+                Body::AttemptTerminal {
+                    attempt_id: attempt,
+                    disposition,
+                    response_id: metadata.response_id,
+                    effective_model: metadata.effective_model,
+                    readings: metadata.readings,
+                },
+            )
+            .await?;
+        attempts.active = None;
+        Ok(())
+    }
+
+    pub async fn close(&self, disposition: Terminal) -> Result<(), Error> {
+        let mut attempts = self.attempts.clone().lock_owned().await;
+        if attempts.closed {
+            return Err(Error::Protocol);
+        }
+        let disposition = match disposition {
+            Terminal::ResponseCompleted => CloseDisposition::Completed,
+            Terminal::Cancelled => CloseDisposition::Cancelled,
+            Terminal::ResponseIncomplete | Terminal::HttpError | Terminal::TransportError => {
+                CloseDisposition::Failed
+            }
+        };
+        self.producer
+            .emit(
+                &self.member,
+                Body::OperationClose {
+                    operation_id: self.id.clone(),
+                    disposition,
+                },
+            )
+            .await?;
+        attempts.closed = true;
+        Ok(())
+    }
+}
+
+impl Producer {
+    pub async fn open_operation(
+        self: &Arc<Self>,
+        native: &str,
+        turn: Option<&str>,
+        qualified: bool,
+    ) -> Result<Arc<Operation>, Error> {
+        let writer = self.writers.clone().read_owned().await;
+        if self.closing.load(Ordering::SeqCst) {
+            return Err(Error::Fenced);
+        }
+        let member = self
+            .family
+            .lock()
+            .await
+            .members
+            .get(native)
+            .filter(|member| member.qualified)
+            .map(|v| v.id.clone());
+        let member = member.ok_or(Error::Protocol)?;
+        let id = self.id("operation")?;
+        if !qualified {
+            return Err(Error::Protocol);
+        }
+        let revision = self
+            .channel
+            .lock()
+            .await
+            .bootstrap
+            .configuration_revision
+            .clone();
+        self.emit(
+            &member,
+            Body::OperationOpen {
+                operation_id: id.clone(),
+                turn_id: turn.map(Id::parse).transpose()?,
+                operation_class: OperationClass::Generation,
+                transport_class: TransportClass::HttpResponses,
+                requested_model: Model::Gpt61Sol,
+                requested_effort: Effort::High,
+                configuration_revision: revision,
+            },
+        )
+        .await?;
+        Ok(Arc::new(Operation {
+            producer: self.clone(),
+            member,
+            id,
+            attempts: Arc::new(Mutex::new(Attempts {
+                previous: None,
+                active: None,
+                closed: false,
+            })),
+            _writer: writer,
+        }))
+    }
+}
diff --git a/codex-rs/http-client/src/accounting/readings.rs b/codex-rs/http-client/src/accounting/readings.rs
new file mode 100644
index 0000000000000000000000000000000000000000..1edc0ea63d4b3e581aaeff792a96b2e7f3836498
--- /dev/null
+++ b/codex-rs/http-client/src/accounting/readings.rs
@@ -0,0 +1,84 @@
+use serde::Serialize;
+
+#[derive(Clone, Debug, Serialize)]
+#[serde(tag = "status", rename_all = "snake_case")]
+pub enum Reading {
+    Observed {
+        value: u64,
+        reason: Option<()>,
+    },
+    Missing {
+        value: Option<()>,
+        reason: MissingReason,
+    },
+    Error {
+        value: Option<()>,
+        reason: ErrorReason,
+    },
+}
+#[derive(Clone, Copy, Debug, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum MissingReason {
+    NotAvailable,
+}
+#[derive(Clone, Copy, Debug, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum ErrorReason {
+    SourceError,
+}
+#[derive(Clone, Debug, Serialize)]
+pub struct Readings {
+    pub input_total: Reading,
+    pub cached_input: Reading,
+    pub cache_write_input: Reading,
+    pub output_total: Reading,
+    pub reasoning_output: Reading,
+    pub total_tokens: Reading,
+}
+
+impl Readings {
+    pub fn missing() -> Self {
+        Self::from_usage(None)
+    }
+    pub fn from_usage(usage: Option<&serde_json::Value>) -> Self {
+        let reading = |path: &[&str]| {
+            let mut value = usage;
+            for key in path {
+                value = match value {
+                    None | Some(serde_json::Value::Null) => None,
+                    Some(serde_json::Value::Object(object)) => object.get(*key),
+                    Some(_) => {
+                        return Reading::Error {
+                            value: None,
+                            reason: ErrorReason::SourceError,
+                        };
+                    }
+                };
+            }
+            match value {
+                None | Some(serde_json::Value::Null) => Reading::Missing {
+                    value: None,
+                    reason: MissingReason::NotAvailable,
+                },
+                Some(value) => match value.as_u64().filter(|v| *v <= 9_007_199_254_740_991) {
+                    Some(value) => Reading::Observed {
+                        value,
+                        reason: None,
+                    },
+                    None => Reading::Error {
+                        value: None,
+                        reason: ErrorReason::SourceError,
+                    },
+                },
+            }
+        };
+        Self {
+            input_total: reading(&["input_tokens"]),
+            cached_input: reading(&["input_tokens_details", "cached_tokens"]),
+            cache_write_input: reading(&["input_tokens_details", "cache_write_tokens"]),
+            output_total: reading(&["output_tokens"]),
+            reasoning_output: reading(&["output_tokens_details", "reasoning_tokens"]),
+            total_tokens: reading(&["total_tokens"]),
+        }
+    }
+}
diff --git a/codex-rs/http-client/src/accounting/test_receiver.rs b/codex-rs/http-client/src/accounting/test_receiver.rs
new file mode 100644
index 0000000000000000000000000000000000000000..69378c56b9e86415132e01a1917bf237b8af52bb
--- /dev/null
+++ b/codex-rs/http-client/src/accounting/test_receiver.rs
@@ -0,0 +1,116 @@
+use super::*;
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+use tokio::io::{AsyncBufReadExt, AsyncWriteExt, BufReader};
+use tokio::net::UnixStream;
+
+pub(super) const ROOT: &str = "00000000-0000-4000-8000-000000000001";
+pub(super) const ROOT_MEMBER: &str = "harness:root";
+
+pub(super) struct Receiver {
+    stream: BufReader<UnixStream>,
+    control: u64,
+    sequence: u64,
+    hash: Option<String>,
+    pub(super) records: Vec<Value>,
+}
+impl Receiver {
+    async fn new(stream: UnixStream) -> Self {
+        let mut receiver = Self {
+            stream: BufReader::new(stream),
+            control: 0,
+            sequence: 0,
+            hash: None,
+            records: Vec::new(),
+        };
+        let bootstrap = json!({
+            "schema_version":1,"protocol":"harness-codex-accounting-v1",
+            "run_id":"run:test","producer_instance_id":"producer:test","task_generation":7,
+            "configuration_receipt_id":"config:test","configuration_revision":"revision:test",
+            "root_session_id":ROOT_MEMBER
+        });
+        receiver.frame(bootstrap).await;
+        receiver
+    }
+    async fn frame(&mut self, value: Value) {
+        let mut bytes = serde_json::to_vec(&value)
+            .unwrap_or_else(|error| panic!("synthetic receiver fixture failed: {error}"));
+        bytes.push(b'\n');
+        self.stream
+            .get_mut()
+            .write_all(&bytes)
+            .await
+            .unwrap_or_else(|error| panic!("synthetic receiver fixture failed: {error}"));
+    }
+    pub(super) async fn read(&mut self) -> Value {
+        let mut bytes = Vec::new();
+        self.stream
+            .read_until(b'\n', &mut bytes)
+            .await
+            .unwrap_or_else(|error| panic!("synthetic receiver fixture failed: {error}"));
+        assert_eq!(bytes.pop(), Some(b'\n'));
+        let record: Value = serde_json::from_slice(&bytes)
+            .unwrap_or_else(|error| panic!("synthetic receiver fixture failed: {error}"));
+        self.sequence += 1;
+        assert_eq!(record["sequence"], self.sequence);
+        assert_eq!(record["previous_record_hash"], json!(self.hash));
+        self.hash = Some(format!("{:x}", Sha256::digest(&bytes)));
+        self.records.push(record.clone());
+        record
+    }
+    pub(super) async fn receipt(&mut self, body: Value) {
+        self.control += 1;
+        self.frame(
+            json!({"schema_version":1,"receipt_id":format!("receipt:{}",self.control),
+            "run_id":"run:test","control_sequence":self.control,
+            "recorded_at":"2026-10-12T00:00:00.000Z","body":body}),
+        )
+        .await;
+    }
+    async fn commit(&mut self) {
+        self.receipt(
+            json!({"kind":"record_committed","producer_sequence":self.sequence,
+            "producer_record_hash":self.hash}),
+        )
+        .await;
+    }
+    pub(super) async fn accept(&mut self) -> Value {
+        let record = self.read().await;
+        let body = &record["body"];
+        let gate = match body["kind"]
+            .as_str()
+            .unwrap_or_else(|| panic!("synthetic receiver kind is missing"))
+        {
+            "member_ready" => Some(json!({"kind":"member_admitted",
+                "member_id":record["member_id"],"session_id":body["native_session_id"]})),
+            "child_reserve" => Some(json!({"kind":"child_reserved",
+                "child_reservation_id":format!("child:{}",self.sequence),
+                "parent_member_id":body["parent_member_id"]})),
+            "attempt_reserve" => Some(json!({"kind":"attempt_reserved",
+                "attempt_id":format!("attempt:{}",self.sequence),"operation_id":body["operation_id"],
+                "member_id":record["member_id"],"retry_parent_attempt_id":body["retry_parent_attempt_id"]})),
+            "dispatch_commit" => {
+                Some(json!({"kind":"dispatch_committed","attempt_id":body["attempt_id"]}))
+            }
+            "close_request" => Some(json!({"kind":"close_fence","close_fence_id":"fence:test"})),
+            _ => None,
+        };
+        match gate {
+            Some(gate) => self.receipt(gate).await,
+            None => self.commit().await,
+        }
+        record
+    }
+}
+
+pub(super) async fn pair() -> (Arc<Producer>, Receiver) {
+    let (producer, receiver) = UnixStream::pair()
+        .unwrap_or_else(|error| panic!("synthetic receiver fixture failed: {error}"));
+    let receiver = Receiver::new(receiver).await;
+    (
+        Producer::connect(producer)
+            .await
+            .unwrap_or_else(|error| panic!("synthetic receiver fixture failed: {error}")),
+        receiver,
+    )
+}
diff --git a/codex-rs/http-client/src/accounting/tests.rs b/codex-rs/http-client/src/accounting/tests.rs
