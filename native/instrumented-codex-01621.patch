new file mode 100644
index 0000000000000000000000000000000000000000..e829d881e86dd00dd87ce8c3eda80a250a4fdb95
--- /dev/null
+++ b/codex-rs/http-client/src/accounting/descriptor.rs
@@ -0,0 +1,21 @@
+use std::os::fd::{FromRawFd, OwnedFd};
+use std::sync::atomic::{AtomicBool, Ordering};
+
+static CLAIMED: AtomicBool = AtomicBool::new(false);
+
+pub(super) fn take_fd3() -> Result<tokio::net::UnixStream, super::Error> {
+    if CLAIMED.swap(true, Ordering::SeqCst) {
+        return Err(super::Error::Protocol);
+    }
+    // SAFETY: [Category 13 - ownership contract] the opt-in trusted launcher
+    // transfers exclusive ownership of open socket FD3 to this entry point.
+    // CLAIMED prevents a second owner; no pointer or memory ABI crosses FFI.
+    let fd = unsafe { OwnedFd::from_raw_fd(3) };
+    // OwnedFd::try_clone uses F_DUPFD_CLOEXEC. Closing the inherited original
+    // before returning leaves only the private, non-inheritable duplicate.
+    let private = fd.try_clone()?;
+    drop(fd);
+    let stream = std::os::unix::net::UnixStream::from(private);
+    stream.set_nonblocking(true)?;
+    Ok(tokio::net::UnixStream::from_std(stream)?)
+}
diff --git a/codex-rs/http-client/src/accounting/lifecycle.rs b/codex-rs/http-client/src/accounting/lifecycle.rs
new file mode 100644
index 0000000000000000000000000000000000000000..0f64b9587e13e8ef2ea5e0baa57df125d59e4da5
--- /dev/null
+++ b/codex-rs/http-client/src/accounting/lifecycle.rs
@@ -0,0 +1,189 @@
+use super::wire::*;
+use super::{Error, Producer};
+use std::sync::atomic::Ordering;
+
+impl Producer {
+    pub async fn admit(
+        &self,
+        native: &str,
+        parent: Option<&str>,
+        ordinary: bool,
+    ) -> Result<(), Error> {
+        let mut family = self.family.clone().lock_owned().await;
+        if self.closing.load(Ordering::SeqCst) {
+            return Err(Error::Fenced);
+        }
+        let native_id = match parent {
+            Some(_) => Id::parse(native)?,
+            None => self
+                .channel
+                .clone()
+                .lock_owned()
+                .await
+                .bootstrap
+                .root_session_id
+                .clone(),
+        };
+        if let Some(member) = family.members.get_mut(native) {
+            if !ordinary {
+                member.qualified = false;
+                let member_id = member.id.clone();
+                if self
+                    .emit(
+                        &member_id,
+                        Body::UnsupportedOperation {
+                            operation_id: self.id("unsupported")?,
+                            operation_class: OperationClass::Unknown,
+                            transport_class: TransportClass::Unknown,
+                            reason: Reason::UnsupportedProfile,
+                        },
+                    )
+                    .await
+                    .is_err()
+                {
+                    tracing::warn!("accounting receiver unavailable before unqualified resume");
+                }
+                return Ok(());
+            }
+            return Err(Error::Protocol);
+        }
+        let supported_parent = match parent {
+            Some(parent) => family
+                .members
+                .get(parent)
+                .map(|member| member.id.clone())
+                .filter(|id| Some(id) == family.root.as_ref()),
+            None => None,
+        };
+        let topology_ok = match parent {
+            None => family.root.is_none(),
+            Some(_) => supported_parent.is_some() && family.children < 2,
+        };
+        if !ordinary || !topology_ok {
+            let member = family.root.as_ref().unwrap_or(&native_id);
+            if self
+                .emit(
+                    member,
+                    Body::UnsupportedOperation {
+                        operation_id: self.id("unsupported")?,
+                        operation_class: OperationClass::Unknown,
+                        transport_class: TransportClass::Unknown,
+                        reason: if ordinary {
+                            Reason::TopologyMismatch
+                        } else {
+                            Reason::UnsupportedProfile
+                        },
+                    },
+                )
+                .await
+                .is_err()
+            {
+                tracing::warn!(
+                    "accounting receiver unavailable before unqualified session admission"
+                );
+            }
+            return Ok(());
+        }
+        let reservation = match supported_parent.as_ref() {
+            Some(parent) => {
+                match self
+                    .emit(
+                        parent,
+                        Body::ChildReserve {
+                            parent_member_id: parent.clone(),
+                        },
+                    )
+                    .await?
+                {
+                    Gate::ChildReserved {
+                        child_reservation_id,
+                        parent_member_id,
+                    } if parent_member_id == *parent => Some(child_reservation_id),
+                    _ => return Err(Error::Protocol),
+                }
+            }
+            None => None,
+        };
+        let configuration_receipt_id = self
+            .channel
+            .lock()
+            .await
+            .bootstrap
+            .configuration_receipt_id
+            .clone();
+        match self
+            .emit(
+                &native_id,
+                Body::MemberReady {
+                    native_session_id: native.to_owned(),
+                    parent_member_id: supported_parent,
+                    child_reservation_id: reservation,
+                    configuration_receipt_id,
+                },
+            )
+            .await?
+        {
+            Gate::MemberAdmitted {
+                member_id,
+                session_id: _session_id,
+            } if member_id == native_id => {}
+            _ => return Err(Error::Protocol),
+        }
+        if parent.is_some() {
+            family.children = family.children.checked_add(1).ok_or(Error::Protocol)?;
+        } else {
+            family.root = Some(native_id.clone());
+        }
+        family.members.insert(
+            native.to_owned(),
+            super::NativeMember {
+                id: native_id,
+                stopped: false,
+                qualified: true,
+            },
+        );
+        Ok(())
+    }
+
+    pub async fn close_family(&self) -> Result<(), Error> {
+        if self.closing.swap(true, Ordering::SeqCst) {
+            return Err(Error::Fenced);
+        }
+        let root = self.root().await?;
+        let fence = match self.emit(&root, Body::CloseRequest).await? {
+            Gate::CloseFence { close_fence_id } => close_fence_id,
+            _ => return Err(Error::Protocol),
+        };
+        let _drain = self.writers.clone().write_owned().await;
+        let family = self.family.clone().lock_owned().await;
+        for member in family.members.values() {
+            if !member.stopped {
+                self.emit(
+                    &member.id,
+                    Body::UnsupportedOperation {
+                        operation_id: self.id("unclosed")?,
+                        operation_class: OperationClass::Unknown,
+                        transport_class: TransportClass::Unknown,
+                        reason: Reason::MissingMemberClose,
+                    },
+                )
+                .await?;
+                continue;
+            }
+            let channel = self.channel.clone().lock_owned().await;
+            let sequence = channel.sequence;
+            let hash = channel.hash.clone();
+            drop(channel);
+            self.emit(
+                &member.id,
+                Body::MemberClose {
+                    close_fence_id: fence.clone(),
+                    final_record_sequence: sequence,
+                    final_record_hash: hash,
+                },
+            )
+            .await?;
+        }
+        Ok(())
+    }
+}
diff --git a/codex-rs/http-client/src/accounting/mod.rs b/codex-rs/http-client/src/accounting/mod.rs
