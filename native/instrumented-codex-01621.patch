+    let receive = async move {
+        receiver.accept().await;
+        receiver.accept().await;
+        let record = receiver.read().await;
+        assert_eq!(record["body"]["kind"], "unsupported_operation");
+        drop(receiver);
+    };
+    let ((status, generation), _, _) = tokio::time::timeout(RECEIPT_TIMEOUT, async {
+        tokio::join!(work, receive, server)
+    })
+    .await
+    .unwrap();
+    // Then
+    assert_eq!(status, http::StatusCode::NO_CONTENT);
+    assert!(matches!(generation, Err(Error::Lost)));
+}
