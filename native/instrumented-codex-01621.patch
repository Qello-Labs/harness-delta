+#[test]
+fn canonical_hash_sorts_nested_keys_without_reordering_arrays() {
+    // Given
+    let value: serde_json::Value =
+        serde_json::from_str(r#"{"z":[{"b":2,"a":1},0],"a":{"d":null,"c":"x"}}"#).unwrap();
+    // When
+    let bytes = super::channel::canonical_bytes(&value).unwrap();
+    // Then
+    assert_eq!(bytes, br#"{"a":{"c":"x","d":null},"z":[{"a":1,"b":2},0]}"#);
+}
