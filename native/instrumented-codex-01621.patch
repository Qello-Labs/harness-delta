+#[tokio::test]
+async fn lost_reservation_receipt_prevents_any_transport_handoff() {
+    // Given
+    let (producer, mut receiver) = pair().await;
+    let listener = std::net::TcpListener::bind(("127.0.0.1", 0)).unwrap();
+    listener.set_nonblocking(true).unwrap();
+    let url = format!("http://{}/responses", listener.local_addr().unwrap());
+    let work = async {
+        producer.admit(ROOT, None, true).await.unwrap();
+        let operation = producer.open_operation(ROOT, None, true).await.unwrap();
+        let inner = reqwest::Client::builder().no_proxy().build().unwrap();
+        // When
+        operation
+            .scope(HttpClient::new(inner).post(url).send())
+            .await
+    };
+    let receive = async move {
+        receiver.accept().await;
+        receiver.accept().await;
+        let record = receiver.read().await;
+        assert_eq!(record["body"]["kind"], "attempt_reserve");
+        drop(receiver);
+    };
+    let (result, _) = tokio::time::timeout(RECEIPT_TIMEOUT, async { tokio::join!(work, receive) })
+        .await
+        .unwrap();
+    // Then
+    assert!(matches!(result, Err(crate::HttpError::Build(_))));
+    assert_eq!(
+        listener.accept().unwrap_err().kind(),
+        std::io::ErrorKind::WouldBlock
+    );
+    assert!(producer.broken.load(std::sync::atomic::Ordering::SeqCst));
+}
+
+#[tokio::test]
+async fn cancellation_during_acknowledgment_poison_stream_instead_of_reusing_it() {
+    // Given
+    let (producer, mut receiver) = pair().await;
+    let record_seen = tokio::sync::Notify::new();
+    let cancellation = record_seen.notified();
+    tokio::pin!(cancellation);
+    cancellation.as_mut().enable();
+    let send = producer.admit(ROOT, None, true);
+    // When
+    let cancel = async {
+        tokio::select! {
+            result = send => panic!("receipt was not delivered: {result:?}"),
+            _ = cancellation => {}
+        }
+    };
+    let receive = async {
+        receiver.read().await;
+        record_seen.notify_one();
+    };
+    tokio::time::timeout(RECEIPT_TIMEOUT, async { tokio::join!(cancel, receive) })
+        .await
+        .unwrap();
+    // Then
+    assert!(producer.broken.load(std::sync::atomic::Ordering::SeqCst));
+    assert!(matches!(
+        producer.admit(ROOT, None, true).await,
+        Err(Error::Lost)
+    ));
+}
