+#[tokio::test]
+async fn transport_handoff_waits_for_durable_dispatch_receipt() {
+    // Given
+    let (producer, mut receiver) = pair().await;
+    let listener = tokio::net::TcpListener::bind(("127.0.0.1", 0))
+        .await
+        .unwrap();
+    let url = format!("http://{}/responses", listener.local_addr().unwrap());
+    let (sent, mut observed) = tokio::sync::mpsc::channel(1);
+    let server = async {
+        let (mut stream, _) = listener.accept().await.unwrap();
+        let mut buffer = [0; 4096];
+        assert!(stream.read(&mut buffer).await.unwrap() > 0);
+        sent.send(()).await.unwrap();
+        stream
+            .write_all(b"HTTP/1.1 204 No Content\r\nConnection: close\r\n\r\n")
+            .await
+            .unwrap();
+    };
+    let work = async {
+        producer.admit(ROOT, None, true).await.unwrap();
+        let operation = producer.open_operation(ROOT, None, true).await.unwrap();
+        let inner = reqwest::Client::builder()
+            .no_proxy()
+            .redirect(reqwest::redirect::Policy::none())
+            .retry(reqwest::retry::never())
+            .http1_only()
+            .pool_max_idle_per_host(0)
+            .build()
+            .unwrap();
+        // When
+        let response = operation
+            .clone()
+            .scope(HttpClient::new(inner).post(url).send())
+            .await
+            .unwrap();
+        assert_eq!(response.status(), http::StatusCode::NO_CONTENT);
+        operation
+            .terminal(Terminal::ResponseCompleted, TerminalMetadata::missing())
+            .await
+            .unwrap();
+        operation.close(Terminal::ResponseCompleted).await.unwrap();
+    };
+    let receive = async {
+        receiver.accept().await;
+        receiver.accept().await;
+        receiver.accept().await;
+        let commit = receiver.read().await;
+        assert_eq!(commit["body"]["kind"], "dispatch_commit");
+        // Then: the request cannot pass the gate while its receipt is withheld.
+        assert!(matches!(
+            observed.try_recv(),
+            Err(tokio::sync::mpsc::error::TryRecvError::Empty)
+        ));
+        receiver
+            .receipt(json!({"kind":"dispatch_committed","attempt_id":commit["body"]["attempt_id"]}))
+            .await;
+        observed.recv().await.unwrap();
+        receiver.accept().await;
+        receiver.accept().await;
+    };
+    tokio::time::timeout(RECEIPT_TIMEOUT, async {
+        tokio::join!(work, receive, server)
+    })
+    .await
+    .unwrap();
+}
