+'use strict';
+
+const assert = require('node:assert/strict');
+const { createHash } = require('node:crypto');
+const { spawn } = require('node:child_process');
+const { mkdtempSync } = require('node:fs');
+const { tmpdir } = require('node:os');
+const { join } = require('node:path');
+const { createServer } = require('node:http');
+const { once } = require('node:events');
+
+function canonical(value) {
+  if (Array.isArray(value)) return `[${value.map(canonical).join(',')}]`;
+  if (value !== null && typeof value === 'object') {
+    return `{${Object.keys(value).sort().map(key => `${JSON.stringify(key)}:${canonical(value[key])}`).join(',')}}`;
+  }
+  return JSON.stringify(value);
+}
+
+function hash(value) {
+  return createHash('sha256').update(canonical(value)).digest('hex');
+}
+
+async function main() {
+  const binary = process.argv[2];
+  const toolScenario = process.argv[3] === 'tool';
+  assert.ok(binary, 'pass the exact built codex executable');
+  const home = mkdtempSync(join(tmpdir(), 'codex-accounting-descriptor-'));
+  const records = [];
+  const attempts = new Map();
+  let requests = 0;
+  let control = 0;
+  let lastHash = null;
+  let stderrBytes = 0;
+  let receiverFailure = null;
+  const server = createServer((request, response) => {
+    request.resume();
+    assert.equal(request.url, '/v1/responses');
+    requests += 1;
+    assert.equal([...attempts.values()].filter(value => value === 'dispatched').length, 1);
+    response.writeHead(200, { 'content-type': 'text/event-stream', connection: 'close' });
+    const toolItem = { id: 'fc_synthetic', type: 'function_call', call_id: 'call_synthetic',
+      name: 'exec_command', arguments: JSON.stringify({ cmd: 'printf "Synthetic tool output."', yield_time_ms: 1000, max_output_tokens: 100 }) };
+    const events = [
+      { type: 'response.created', response: { id: 'resp_synthetic' } },
+      { type: 'response.output_item.done', item: toolScenario && requests === 1 ? toolItem : {
+        id: 'msg_synthetic', type: 'message', role: 'assistant',
+        content: [{ type: 'output_text', text: 'Synthetic local response.' }],
+      } },
+      { type: 'response.completed', response: {
+        id: 'resp_synthetic', model: 'gpt-6.1-sol',
+        usage: { input_tokens: 3, input_tokens_details: { cached_tokens: 0 },
+          output_tokens: 2, output_tokens_details: { reasoning_tokens: 1 }, total_tokens: 5 },
+      } },
+    ];
+    response.end(events.map(event => `data: ${JSON.stringify(event)}\n\n`).join(''));
+  });
+  server.listen(0, '127.0.0.1');
+  await once(server, 'listening');
+  const url = `http://127.0.0.1:${server.address().port}/v1`;
+  const child = spawn(binary, [
+    '--harness-accounting-fd3', 'exec', '--skip-git-repo-check',
+    '-c', `model_providers.mock={name="mock",base_url="${url}",env_key="HARNESS_SYNTHETIC_KEY",wire_api="responses",supports_websockets=false}`,
+    '-c', 'model_provider="mock"', '-c', 'model="gpt-6.1-sol"',
+    '-c', 'model_reasoning_effort="high"', '-C', home, 'Synthetic local fixture.',
+  ], { env: { ...process.env, CODEX_HOME: home, HARNESS_SYNTHETIC_KEY: 'synthetic' },
+    stdio: ['ignore', 'pipe', 'pipe', 'pipe'] });
+  const exit = once(child, 'exit');
+  child.stdout.resume();
+  child.stderr.on('data', bytes => { stderrBytes += bytes.length; });
+  const stream = child.stdio[3];
+  function receipt(body) {
+    control += 1;
+    stream.write(`${JSON.stringify({ schema_version: 1, receipt_id: `receipt:${control}`,
+      run_id: 'run:fixture', control_sequence: control,
+      recorded_at: '2026-10-12T00:00:00.000Z', body })}\n`);
+  }
+  let buffer = '';
+  stream.setEncoding('utf8');
+  stream.on('data', chunk => {
+    try {
+      buffer += chunk;
+      let end;
+      while ((end = buffer.indexOf('\n')) !== -1) {
+        const record = JSON.parse(buffer.slice(0, end));
+        buffer = buffer.slice(end + 1);
+        assert.equal(record.sequence, records.length + 1);
+        assert.equal(record.previous_record_hash, lastHash);
+        assert.equal(record.run_id, 'run:fixture');
+        assert.equal(record.task_generation, 7);
+        const previousSequence = records.length;
+        const previousHash = lastHash;
+        lastHash = hash(record);
+        records.push(record);
+        const body = record.body;
+        switch (body.kind) {
+          case 'member_ready':
+            assert.equal(record.member_id, 'harness:fixture-root');
+            assert.match(body.native_session_id, /^[a-f0-9-]{36}$/);
+            receipt({ kind: 'member_admitted', member_id: record.member_id, session_id: record.member_id });
+            break;
+          case 'attempt_reserve': {
+            const id = `attempt:${record.sequence}`;
+            attempts.set(id, 'reserved');
+            receipt({ kind: 'attempt_reserved', attempt_id: id, operation_id: body.operation_id,
+              member_id: record.member_id, retry_parent_attempt_id: body.retry_parent_attempt_id });
+            break;
+          }
+          case 'dispatch_commit':
+            assert.equal(attempts.get(body.attempt_id), 'reserved');
+            attempts.set(body.attempt_id, 'dispatched');
+            receipt({ kind: 'dispatch_committed', attempt_id: body.attempt_id });
+            break;
+          case 'close_request':
+            receipt({ kind: 'close_fence', close_fence_id: 'fence:fixture' });
+            break;
+          case 'attempt_terminal':
+            assert.equal(attempts.get(body.attempt_id), 'dispatched');
+            attempts.set(body.attempt_id, 'terminal');
+            assert.equal(body.readings.input_total.value, 3);
+            assert.equal(body.readings.cache_write_input.status, 'missing');
+            assert.equal(body.effective_model, 'gpt-6.1-sol');
+            receipt({ kind: 'record_committed', producer_sequence: record.sequence, producer_record_hash: lastHash });
+            break;
+          case 'member_close':
+            assert.equal(body.final_record_sequence, previousSequence);
+            assert.equal(body.final_record_hash, previousHash);
+            receipt({ kind: 'record_committed', producer_sequence: record.sequence, producer_record_hash: lastHash });
+            break;
+          case 'operation_open':
+          case 'operation_close':
+          case 'unsupported_operation':
+            receipt({ kind: 'record_committed', producer_sequence: record.sequence, producer_record_hash: lastHash });
+            break;
+          default:
+            assert.fail(`unexpected kind ${body.kind}`);
+        }
+      }
+    } catch (error) {
+      receiverFailure = error;
+      child.kill('SIGTERM');
+    }
+  });
+  stream.on('error', error => { receiverFailure ??= error; });
+  stream.write(`${JSON.stringify({ schema_version: 1, protocol: 'harness-codex-accounting-v1',
+    run_id: 'run:fixture', producer_instance_id: 'producer:fixture', task_generation: 7,
+    configuration_receipt_id: 'config:fixture', configuration_revision: 'config:fixture',
+    root_session_id: 'harness:fixture-root' })}\n`);
+  const timer = setTimeout(() => child.kill('SIGTERM'), 60000);
+  const [code, signal] = await exit;
+  clearTimeout(timer);
+  server.close();
+  if (receiverFailure) throw receiverFailure;
+  assert.equal(code, 0, `native CLI exit ${code}, signal ${signal}, stderr bytes ${stderrBytes}`);
+  assert.equal(requests, toolScenario ? 2 : 1);
+  assert.equal(attempts.size, requests);
+  assert.ok([...attempts.values()].every(value => value === 'terminal'));
+  assert.ok(records.some(record => record.body.kind === 'close_request'));
+  assert.ok(records.some(record => record.body.kind === 'member_close'));
+  const partial = records.filter(record => record.body.kind === 'unsupported_operation').map(record => ({
+    sequence: record.sequence, reason: record.body.reason,
+    operation_class: record.body.operation_class, transport_class: record.body.transport_class,
+  }));
+  if (toolScenario) assert.ok(partial.some(value => value.reason === 'unsupported_operation'));
+  console.log(`PASS native descriptor receiver: ${records.length} canonical records, ${requests} gated localhost request, terminal and family fence acknowledged; partial=${JSON.stringify(partial)}`);
+}
+
+main().catch(error => { console.error(error); process.exitCode = 1; });
diff --git a/codex-rs/http-client/src/accounting/channel.rs b/codex-rs/http-client/src/accounting/channel.rs
new file mode 100644
index 0000000000000000000000000000000000000000..c918a5a33c0cb9510efb3847fcb96aca1fed8490
--- /dev/null
+++ b/codex-rs/http-client/src/accounting/channel.rs
@@ -0,0 +1,231 @@
+use super::Error;
+use super::wire::*;
+use sha2::{Digest, Sha256};
+use std::sync::atomic::{AtomicBool, Ordering};
+use tokio::io::{AsyncBufReadExt, AsyncWriteExt, BufReader};
+use tokio::net::UnixStream;
+
+pub(super) struct Channel {
+    pub bootstrap: Bootstrap,
+    pub sequence: u64,
+    pub hash: Option<String>,
+    control_sequence: u64,
+    stream: BufReader<UnixStream>,
+}
+
+impl Channel {
+    pub async fn connect(stream: UnixStream) -> Result<Self, Error> {
+        let mut stream = BufReader::new(stream);
+        let bootstrap: Bootstrap = read_frame(&mut stream).await?;
+        if bootstrap.schema_version != 1
+            || bootstrap.protocol != "harness-codex-accounting-v1"
+            || bootstrap.task_generation > 9_007_199_254_740_991
+        {
+            return Err(Error::Protocol);
+        }
+        Ok(Self {
+            bootstrap,
+            sequence: 0,
+            hash: None,
+            control_sequence: 0,
+            stream,
+        })
+    }
+
+    pub async fn send(&mut self, member: &Id, body: Body) -> Result<Gate, Error> {
+        let needs_gate = matches!(
+            &body,
+            Body::MemberReady { .. }
+                | Body::ChildReserve { .. }
+                | Body::AttemptReserve { .. }
+                | Body::DispatchCommit { .. }
+                | Body::CloseRequest
+        );
+        self.sequence = self.sequence.checked_add(1).ok_or(Error::Protocol)?;
+        if self.sequence > 9_007_199_254_740_991 {
+            return Err(Error::Protocol);
+        }
+        let record = Record {
+            schema_version: 1,
+            run_id: &self.bootstrap.run_id,
+            producer_instance_id: &self.bootstrap.producer_instance_id,
+            member_id: member,
+            task_generation: self.bootstrap.task_generation,
+            sequence: self.sequence,
+            previous_record_hash: &self.hash,
+            occurred_at: timestamp(std::time::SystemTime::now())?,
+            body,
+        };
+        let value = serde_json::to_value(&record).map_err(|_| Error::Protocol)?;
+        let bytes = canonical_bytes(&value)?;
+        let hash = format!("{:x}", Sha256::digest(&bytes));
+        self.stream.get_mut().write_all(&bytes).await?;
+        self.stream.get_mut().write_all(b"\n").await?;
+        self.stream.get_mut().flush().await?;
+        self.hash = Some(hash.clone());
+        let receipt = self.receipt().await?;
+        if needs_gate {
+            Ok(receipt)
+        } else {
+            match receipt {
+                Gate::RecordCommitted {
+                    producer_sequence,
+                    producer_record_hash,
+                } if producer_sequence == self.sequence && producer_record_hash == hash => {
+                    Ok(Gate::RecordCommitted {
+                        producer_sequence,
+                        producer_record_hash,
+                    })
+                }
+                _ => Err(Error::Protocol),
+            }
+        }
+    }
+
+    async fn receipt(&mut self) -> Result<Gate, Error> {
+        let receipt: Receipt = read_frame(&mut self.stream).await?;
+        if receipt.schema_version != 1
+            || receipt.run_id != self.bootstrap.run_id
+            || Some(receipt.control_sequence) != self.control_sequence.checked_add(1)
+            || receipt.control_sequence > 9_007_199_254_740_991
+            || receipt.recorded_at.len() > 64
+            || !receipt.recorded_at.ends_with('Z')
+        {
+            return Err(Error::Protocol);
+        }
+        self.control_sequence = receipt.control_sequence;
+        let _receipt_id = receipt.receipt_id;
+        match receipt.body {
+            Gate::ScopeRevoked { reason: _reason } => Err(Error::Revoked),
+            body => Ok(body),
+        }
+    }
+}
+
+pub(super) fn canonical_bytes(value: &serde_json::Value) -> Result<Vec<u8>, Error> {
+    fn encode(value: &serde_json::Value, bytes: &mut Vec<u8>) -> Result<(), Error> {
+        match value {
+            serde_json::Value::Object(object) => {
+                bytes.push(b'{');
+                let mut entries: Vec<_> = object.iter().collect();
+                entries.sort_unstable_by_key(|(key, _)| *key);
+                for (index, (key, value)) in entries.into_iter().enumerate() {
+                    if !key.is_ascii() {
+                        return Err(Error::Protocol);
+                    }
+                    if index > 0 {
+                        bytes.push(b',');
+                    }
+                    serde_json::to_writer(&mut *bytes, key).map_err(|_| Error::Protocol)?;
+                    bytes.push(b':');
+                    encode(value, bytes)?;
+                }
+                bytes.push(b'}');
+            }
+            serde_json::Value::Array(array) => {
+                bytes.push(b'[');
+                for (index, value) in array.iter().enumerate() {
+                    if index > 0 {
+                        bytes.push(b',');
+                    }
+                    encode(value, bytes)?;
+                }
+                bytes.push(b']');
+            }
+            serde_json::Value::Number(number) => {
+                if number
+                    .as_u64()
+                    .is_none_or(|value| value > 9_007_199_254_740_991)
+                {
+                    return Err(Error::Protocol);
+                }
+                serde_json::to_writer(&mut *bytes, value).map_err(|_| Error::Protocol)?;
+            }
+            serde_json::Value::String(text) => {
+                if !text.is_ascii() {
+                    return Err(Error::Protocol);
+                }
+                serde_json::to_writer(&mut *bytes, value).map_err(|_| Error::Protocol)?;
+            }
+            serde_json::Value::Null | serde_json::Value::Bool(_) => {
+                serde_json::to_writer(&mut *bytes, value).map_err(|_| Error::Protocol)?;
+            }
+        }
+        Ok(())
+    }
+    let mut bytes = Vec::new();
+    encode(value, &mut bytes)?;
+    Ok(bytes)
+}
+
+fn timestamp(time: std::time::SystemTime) -> Result<String, Error> {
+    let date = httpdate::fmt_http_date(time);
+    let parts: Vec<_> = date.split_ascii_whitespace().collect();
+    let [_, day, month, year, clock, "GMT"] = parts.as_slice() else {
+        return Err(Error::Protocol);
+    };
+    let month = match *month {
+        "Jan" => "01",
+        "Feb" => "02",
+        "Mar" => "03",
+        "Apr" => "04",
+        "May" => "05",
+        "Jun" => "06",
+        "Jul" => "07",
+        "Aug" => "08",
+        "Sep" => "09",
+        "Oct" => "10",
+        "Nov" => "11",
+        "Dec" => "12",
+        _ => return Err(Error::Protocol),
+    };
+    Ok(format!("{year}-{month}-{day}T{clock}Z"))
+}
+
+async fn read_frame<T: serde::de::DeserializeOwned>(
+    stream: &mut BufReader<UnixStream>,
+) -> Result<T, Error> {
+    let mut bytes = Vec::new();
+    loop {
+        let buffer = stream.fill_buf().await?;
+        if buffer.is_empty() {
+            return Err(Error::Lost);
+        }
+        let count = buffer
+            .iter()
+            .position(|v| *v == b'\n')
+            .map(|v| v + 1)
+            .unwrap_or(buffer.len());
+        if bytes.len().saturating_add(count) > 16_384 {
+            return Err(Error::Protocol);
+        }
+        bytes.extend_from_slice(&buffer[..count]);
+        stream.consume(count);
+        if bytes.last() == Some(&b'\n') {
+            return serde_json::from_slice(&bytes).map_err(|_| Error::Protocol);
+        }
+    }
+}
+
+pub(super) struct Exchange<'a> {
+    broken: &'a AtomicBool,
+    committed: bool,
+}
+impl<'a> Exchange<'a> {
+    pub fn new(broken: &'a AtomicBool) -> Self {
+        Self {
+            broken,
+            committed: false,
+        }
+    }
+    pub fn commit(mut self) {
+        self.committed = true;
+    }
+}
+impl Drop for Exchange<'_> {
+    fn drop(&mut self) {
+        if !self.committed {
+            self.broken.store(true, Ordering::SeqCst);
+        }
+    }
+}
