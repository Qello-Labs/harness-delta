@@ -0,0 +1,214 @@
+use super::test_receiver::{ROOT, ROOT_MEMBER, pair};
+use super::*;
+use serde_json::json;
+
+const CHILD: &str = "00000000-0000-4000-8000-000000000002";
+const CHILD2: &str = "00000000-0000-4000-8000-000000000003";
+const CHILD3: &str = "00000000-0000-4000-8000-000000000004";
+
+#[tokio::test]
+async fn reopening_a_member_stays_partial_without_reusing_its_qualified_membership() {
+    let (producer, mut receiver) = pair().await;
+    let work = async {
+        producer.admit(ROOT, None, true).await.unwrap();
+        producer.admit(CHILD, Some(ROOT), true).await.unwrap();
+        producer.admit(CHILD, Some(ROOT), false).await.unwrap();
+        assert!(matches!(
+            producer.open_operation(CHILD, None, true).await,
+            Err(Error::Protocol)
+        ));
+        producer.admit(CHILD2, Some(ROOT), true).await.unwrap();
+        producer.admit(CHILD3, Some(ROOT), true).await.unwrap();
+    };
+    let receive = async {
+        for _ in 0..7 {
+            receiver.accept().await;
+        }
+        receiver.records
+    };
+    let (_, records) = tokio::time::timeout(RECEIPT_TIMEOUT, async { tokio::join!(work, receive) })
+        .await
+        .unwrap();
+    assert_eq!(records[3]["body"]["reason"], "unsupported_profile");
+    assert_eq!(records[6]["body"]["reason"], "topology_mismatch");
+}
+
+#[tokio::test]
+async fn gates_native_children_before_work_and_keeps_lifetime_limit() {
+    // Given
+    let (producer, mut receiver) = pair().await;
+    let work = async {
+        producer.admit(ROOT, None, true).await.unwrap();
+        producer.admit(CHILD, Some(ROOT), true).await.unwrap();
+        producer
+            .family
+            .lock()
+            .await
+            .members
+            .get_mut(CHILD)
+            .unwrap()
+            .stopped = true;
+        producer.admit(CHILD2, Some(ROOT), true).await.unwrap();
+        producer.admit(CHILD3, Some(ROOT), true).await.unwrap();
+        producer
+            .admit("00000000-0000-4000-8000-000000000005", Some(CHILD), true)
+            .await
+            .unwrap();
+    };
+    // When
+    let receive = async {
+        for _ in 0..7 {
+            receiver.accept().await;
+        }
+        receiver.records
+    };
+    let (_, records) = tokio::time::timeout(RECEIPT_TIMEOUT, async { tokio::join!(work, receive) })
+        .await
+        .unwrap();
+    // Then
+    let kinds: Vec<_> = records
+        .iter()
+        .map(|v| v["body"]["kind"].as_str().unwrap())
+        .collect();
+    assert_eq!(
+        kinds,
+        [
+            "member_ready",
+            "child_reserve",
+            "member_ready",
+            "child_reserve",
+            "member_ready",
+            "unsupported_operation",
+            "unsupported_operation"
+        ]
+    );
+    assert_eq!(records[0]["member_id"], ROOT_MEMBER);
+    assert_eq!(records[0]["body"]["native_session_id"], ROOT);
+    assert_eq!(records[2]["body"]["parent_member_id"], ROOT_MEMBER);
+    assert_eq!(records[5]["body"]["reason"], "topology_mismatch");
+}
+
+#[tokio::test]
+async fn reserves_distinct_physical_attempts_before_each_dispatch() {
+    // Given
+    let (producer, mut receiver) = pair().await;
+    let work = async {
+        producer.admit(ROOT, None, true).await.unwrap();
+        let operation = producer
+            .open_operation(ROOT, Some("turn:test"), true)
+            .await
+            .unwrap();
+        // When
+        operation.dispatch().await.unwrap();
+        operation
+            .terminal(Terminal::TransportError, TerminalMetadata::missing())
+            .await
+            .unwrap();
+        operation.dispatch().await.unwrap();
+        operation
+            .terminal(
+                Terminal::ResponseCompleted,
+                TerminalMetadata {
+                    response_id: Some(Id::parse("response:test").unwrap()),
+                    effective_model: None,
+                    readings: Readings::from_usage(Some(
+                        &json!({"input_tokens":0,"output_tokens":2,"total_tokens":2}),
+                    )),
+                },
+            )
+            .await
+            .unwrap();
+        operation.close(Terminal::ResponseCompleted).await.unwrap();
+    };
+    let receive = async {
+        for _ in 0..9 {
+            receiver.accept().await;
+        }
+        receiver.records
+    };
+    let (_, records) = tokio::time::timeout(RECEIPT_TIMEOUT, async { tokio::join!(work, receive) })
+        .await
+        .unwrap();
+    // Then
+    assert_ne!(
+        records[3]["body"]["attempt_id"],
+        records[6]["body"]["attempt_id"]
+    );
+    assert_eq!(
+        records[5]["body"]["retry_parent_attempt_id"],
+        records[3]["body"]["attempt_id"]
+    );
+    assert_eq!(records[7]["body"]["readings"]["input_total"]["value"], 0);
+    assert_eq!(
+        records[7]["body"]["readings"]["cache_write_input"]["status"],
+        "missing"
+    );
+    assert!(records[7]["body"]["effective_model"].is_null());
+}
+
+#[tokio::test]
+async fn closes_only_stopped_members_after_receiver_fence() {
+    // Given
+    let (producer, mut receiver) = pair().await;
+    let work = async {
+        producer.admit(ROOT, None, true).await.unwrap();
+        producer.admit(CHILD, Some(ROOT), true).await.unwrap();
+        producer
+            .family
+            .lock()
+            .await
+            .members
+            .get_mut(ROOT)
+            .unwrap()
+            .stopped = true;
+        // When
+        producer.close_family().await.unwrap();
+        assert!(matches!(
+            producer.open_operation(ROOT, None, true).await,
+            Err(Error::Fenced)
+        ));
+    };
+    let receive = async {
+        for _ in 0..6 {
+            receiver.accept().await;
+        }
+        receiver.records
+    };
+    let (_, records) = tokio::time::timeout(RECEIPT_TIMEOUT, async { tokio::join!(work, receive) })
+        .await
+        .unwrap();
+    // Then
+    assert_eq!(records[3]["body"]["kind"], "close_request");
+    assert_eq!(records[4]["body"]["kind"], "member_close");
+    assert_eq!(records[4]["body"]["close_fence_id"], "fence:test");
+    assert_eq!(records[5]["body"]["reason"], "missing_member_close");
+}
+
+#[test]
+fn raw_readings_preserve_missing_invalid_and_observed_zero() {
+    // Given
+    let usage = json!({"input_tokens":0,"output_tokens":-1,"total_tokens":9007199254740992u64,
+        "input_tokens_details":{"cached_tokens":0},"output_tokens_details":{}});
+    // When
+    let readings = serde_json::to_value(Readings::from_usage(Some(&usage))).unwrap();
+    // Then
+    assert_eq!(readings["input_total"]["status"], "observed");
+    assert_eq!(readings["cached_input"]["value"], 0);
+    assert_eq!(readings["cache_write_input"]["status"], "missing");
+    assert_eq!(readings["reasoning_output"]["status"], "missing");
+    assert_eq!(readings["output_total"]["status"], "error");
+    assert_eq!(readings["total_tokens"]["status"], "error");
+}
+
+#[test]
+fn raw_readings_preserve_invalid_detail_objects_as_errors() {
+    // Given
+    let usage =
+        json!({"input_tokens":1,"input_tokens_details":"invalid","output_tokens_details":42});
+    // When
+    let readings = serde_json::to_value(Readings::from_usage(Some(&usage))).unwrap();
+    // Then
+    assert_eq!(readings["cached_input"]["status"], "error");
+    assert_eq!(readings["cache_write_input"]["status"], "error");
+    assert_eq!(readings["reasoning_output"]["status"], "error");
+}
