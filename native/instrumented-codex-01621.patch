+#[tokio::test]
+async fn production_builder_profile_disables_redirects_and_excludes_http2() {
+    const ISOLATED: &str = "CODEX_ACCOUNTING_BUILDER_TEST";
+    if std::env::var_os(ISOLATED).is_none() {
+        let status = std::process::Command::new(std::env::current_exe().unwrap())
+            .args([
+                "--exact",
+                "accounting::transport_tests::production_builder_profile_disables_redirects_and_excludes_http2",
+                "--nocapture",
+            ])
+            .env(ISOLATED, "1")
+            .status()
+            .unwrap();
+        assert!(status.success());
+        return;
+    }
+    let (producer, mut receiver) = pair().await;
+    assert!(PRODUCER.set(producer.clone()).is_ok());
+    let http2 = crate::HttpClientBuilder::new()
+        .http2_prior_knowledge()
+        .build_direct()
+        .unwrap();
+    let crate::client::HttpClientBackend::Direct(http2) = http2.backend else {
+        panic!("direct builder returned a routed client");
+    };
+    assert!(!http2.accounting_qualified);
+    let client = crate::HttpClientBuilder::new().build_direct().unwrap();
+    let crate::client::HttpClientBackend::Direct(transport) = &client.backend else {
+        panic!("direct builder returned a routed client");
+    };
+    assert!(transport.accounting_qualified);
+    let listener = tokio::net::TcpListener::bind(("127.0.0.1", 0))
+        .await
+        .unwrap();
+    let redirect = std::net::TcpListener::bind(("127.0.0.1", 0)).unwrap();
+    redirect.set_nonblocking(true).unwrap();
+    let response = format!(
+        "HTTP/1.1 303 See Other\r\nLocation: http://{}/responses\r\nContent-Length: 0\r\nConnection: close\r\n\r\n",
+        redirect.local_addr().unwrap()
+    );
+    let url = format!("http://{}/responses", listener.local_addr().unwrap());
+    let server = async {
+        let (mut stream, _) = listener.accept().await.unwrap();
+        let mut buffer = [0; 4096];
+        assert!(stream.read(&mut buffer).await.unwrap() > 0);
+        stream.write_all(response.as_bytes()).await.unwrap();
+    };
+    let work = async {
+        producer.admit(ROOT, None, true).await.unwrap();
+        let operation = producer.open_operation(ROOT, None, true).await.unwrap();
+        let response = operation
+            .clone()
+            .scope(client.post(url).send())
+            .await
+            .unwrap();
+        assert_eq!(response.status(), http::StatusCode::SEE_OTHER);
+        operation.close(Terminal::HttpError).await.unwrap();
+    };
+    let receive = async {
+        for _ in 0..6 {
+            receiver.accept().await;
+        }
+    };
+    tokio::time::timeout(RECEIPT_TIMEOUT, async {
+        tokio::join!(work, receive, server)
+    })
+    .await
+    .unwrap();
+    assert_eq!(
+        redirect.accept().unwrap_err().kind(),
+        std::io::ErrorKind::WouldBlock
+    );
+}
